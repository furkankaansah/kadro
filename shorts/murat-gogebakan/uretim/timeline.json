 },
 "subs": [
  {
   "t0": 0.12,
   "t1": 2.753,
   "text": "Bir zamanlar onun da bir yuvası vardı…"
  },
  {
   "t0": 3.5,
   "t1": 5.508,
   "text": "Bir eşi, bir evladı,"
  },
  {
   "t0": 5.865,
   "t1": 7.723,
   "text": "birlikte kurulmuş *hayalleri…*"
  },
  {
   "t0": 8.544,
   "t1": 10.158,
   "text": "Ama bazı hikâyeler,"
  },
  {
   "t0": 10.551,
   "t1": 13.388,
   "text": "verilen *sözlerin bittiği yerde* yarım kalır."
  },
  {
   "t0": 13.84,
   "t1": 16.097,
   "text": "Mardin'de doğan bir çocuktu o."
  },
  {
   "t0": 16.341,
   "t1": 18.221,
   "text": "Sesindeki o *yanık tını,*"
  },
  {
   "t0": 18.57,
   "t1": 21.015,
   "text": "yaşadığı her acının izini taşıyordu."
  },
  {
   "t0": 21.46,
   "t1": 22.737,
   "text": "*Murat Göğebakan,*"
  },
  {
   "t0": 23.149,
   "t1": 26.461,
   "text": "ilk evliliğinin ardından başka bir hayata adım attı."
  },
  {
   "t0": 27.14,
   "t1": 28.364,
   "text": "Yeniden sevdi,"
  },
  {
   "t0": 28.803,
   "t1": 30.146,
   "text": "yeniden inandı."
  },
  {
   "t0": 30.912,
   "t1": 33.851,
   "text": "Şarkılarında anlattığı o *büyük aşkı,*"
  },
  {
   "t0": 34.25,
   "t1": 36.99,
   "text": "bu kez kendi hayatında yaşayacağını sandı."
  },
  {
   "t0": 37.94,
   "t1": 38.839999999999996,
   "text": "Ama hayat,"
  },
  {
   "t0": 39.188,
   "t1": 41.459,
   "text": "ona en ağır sınavını hazırlıyordu:"
  },
  {
   "t0": 42.038,
   "t1": 43.61,
   "text": "amansız bir *kanser.*"
  },
  {
   "t0": 44.58,
   "t1": 47.777,
   "text": "Hastane odalarında geçen uzun günler başladı."
  },
  {
   "t0": 48.524,
   "t1": 50.566,
   "text": "Basına yansıyan iddialara göre,"
  },
  {
   "t0": 50.875,
   "t1": 53.562,
   "text": "hastanede geçirdiği *208 günün*"
  },
  {
   "t0": 53.615,
   "t1": 55.563,
   "text": "yalnızca *3 gününde*"
  },
  {
   "t0": 55.616,
   "t1": 57.336,
   "text": "ikinci eşi yanındaydı."
  },
  {
   "t0": 57.79,
   "t1": 61.415,
   "text": "Sahnelerde binlerce kişiye şarkı söyleyen o adam,"
  },
  {
   "t0": 61.944,
   "t1": 63.341,
   "text": "hastane odasında,"
  },
  {
   "t0": 63.757,
   "t1": 64.814,
   "text": "*yapayalnızdı.*"
  },
  {
   "t0": 65.96,
   "t1": 68.077,
   "text": "Hastalık yeniden geldiğinde ise,"
  },
  {
   "t0": 68.643,
   "t1": 70.216,
   "text": "onu yalnız bırakmayan,"
  },
  {
   "t0": 70.682,
   "t1": 73.41,
   "text": "yıllar önce ayrıldığı *ilk eşiydi.*"
  },
  {
   "t0": 74.398,
   "t1": 77.289,
   "text": "Bir zamanlar ardında bıraktığı o kadın,"
  },
  {
   "t0": 77.732,
   "t1": 79.006,
   "text": "en zor gününde,"
  },
  {
   "t0": 79.386,
   "t1": 80.946,
   "text": "elini *hiç bırakmadı.*"
  },
  {
   "t0": 81.4,
   "t1": 84.481,
   "text": "İnsan bazen bir kalbin nasıl kırıldığını,"
  },
  {
   "t0": 84.861,
   "t1": 86.923,
   "text": "*kendi kalbi kırılınca* anlar."
  },
  {
   "t0": 87.811,
   "t1": 90.064,
   "text": "Bazı ayrılıklar *sessizdir…*"
  },
  {
   "t0": 90.798,
   "t1": 92.208,
   "text": "Ama bıraktığı iz,"
  },
  {
   "t0": 92.615,
   "t1": 94.188,
   "text": "bir ömür *silinmez.*"
  },
  {
   "t0": 95.33,
   "t1": 97.569,
   "text": "*31 Temmuz 2014'te,*"
  },
  {
   "t0": 97.981,
   "t1": 99.839,
   "text": "henüz *45 yaşındayken,*"
  },
  {
   "t0": 100.373,
   "t1": 103.046,
   "text": "Murat Göğebakan hayata gözlerini yumdu."
  },
  {
   "t0": 103.921,
   "t1": 104.82100000000001,
   "text": "Geriye,"
  },
  {
   "t0": 105.014,
   "t1": 106.627,
   "text": "yarım kalmış şarkılar,"
  },
  {
   "t0": 107.034,
   "t1": 109.721,
   "text": "ve yarım kalmış bir *aşk hikâyesi* kaldı."
  },
  {
   "t0": 112.416,
   "t1": 113.593,
   "text": "Bazen insan,"
  },
  {
   "t0": 113.926,
   "t1": 116.716,
   "text": "başkasına yaşattığı acının ne demek olduğunu"
  },
  {
   "t0": 116.746,
   "t1": 118.17,
   "text": "*yıllar sonra* anlar."
  }
 ],
