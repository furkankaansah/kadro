 },
 "subs": [
  {
   "t0": 0.16,
   "t1": 2.607,
   "text": "Bir zamanlar onun da bir yuvası vardı…"
  },
  {
   "t0": 3.085,
   "t1": 4.87,
   "text": "Bir eşi, bir evladı,"
  },
  {
   "t0": 5.073,
   "t1": 6.733,
   "text": "birlikte kurulmuş *hayalleri…*"
  },
  {
   "t0": 7.397,
   "t1": 8.907,
   "text": "Ama bazı hikâyeler,"
  },
  {
   "t0": 9.185,
   "t1": 11.795,
   "text": "verilen *sözlerin bittiği yerde* yarım kalır."
  },
  {
   "t0": 12.01,
   "t1": 13.276,
   "text": "*Murat Göğebakan,*"
  },
  {
   "t0": 13.54,
   "t1": 16.645,
   "text": "ilk evliliğinin ardından başka bir hayata adım attı."
  },
  {
   "t0": 17.134,
   "t1": 18.399,
   "text": "Yeniden sevdi,"
  },
  {
   "t0": 18.676,
   "t1": 19.87,
   "text": "yeniden inandı."
  },
  {
   "t0": 20.358,
   "t1": 24.112,
   "text": "Belki de bu kez mutluluğun *sonsuza kadar* süreceğini düşündü."
  },
  {
   "t0": 24.36,
   "t1": 25.27,
   "text": "Ama hayat,"
  },
  {
   "t0": 25.52,
   "t1": 28.251,
   "text": "ona en ağır *sınavlarından* birini hazırlıyordu."
  },
  {
   "t0": 28.736,
   "t1": 30.67,
   "text": "*Hastalıkla* mücadele ederken,"
  },
  {
   "t0": 30.87,
   "t1": 33.91,
   "text": "ikinci evliliği de *ihanet iddialarıyla* sarsıldı."
  },
  {
   "t0": 34.496,
   "t1": 36.918,
   "text": "Bir zamanlar mutluluğu arayan o adam,"
  },
  {
   "t0": 37.191,
   "t1": 39.827,
   "text": "bu kez *kendi kalbinin kırılışıyla* yüzleşti."
  },
  {
   "t0": 40.11,
   "t1": 42.92,
   "text": "İnsan bazen bir kalbin nasıl kırıldığını,"
  },
  {
   "t0": 43.285,
   "t1": 45.195,
   "text": "*kendi kalbi kırılınca* anlar."
  },
  {
   "t0": 45.848,
   "t1": 47.945,
   "text": "Bazı ayrılıklar *sessizdir…*"
  },
  {
   "t0": 48.623,
   "t1": 49.957,
   "text": "Ama bıraktığı iz,"
  },
  {
   "t0": 50.173,
   "t1": 51.645,
   "text": "bir ömür *silinmez.*"
  },
  {
   "t0": 53.52,
   "t1": 54.685,
   "text": "Bazen insan,"
  },
  {
   "t0": 54.883,
   "t1": 57.39,
   "text": "başkasına yaşattığı acının ne demek olduğunu"
  },
  {
   "t0": 57.42,
   "t1": 58.817,
   "text": "*yıllar sonra* anlar."
  }
 ],
