 "subs": [
  {
   "t0": 0.27,
   "t1": 2.157,
   "text": "Mustafa Kemal Atatürk'ün,"
  },
  {
   "t0": 2.414,
   "t1": 4.945,
   "text": "komaya girmeden önce söylediği *son sözü,*"
  },
  {
   "t0": 5.429,
   "t1": 6.542,
   "text": "biliyor musunuz?"
  },
  {
   "t0": 7.12,
   "t1": 9.501,
   "text": "*8 Kasım 1938.*"
  },
  {
   "t0": 10.891,
   "t1": 12.527,
   "text": "*Dolmabahçe* Sarayı."
  },
  {
   "t0": 12.87,
   "t1": 16.317,
   "text": "Atatürk'ün sağlığı, artık *son derece ağırlaşmıştı.*"
  },
  {
   "t0": 16.57,
   "t1": 19.93,
   "text": "Türkiye, *büyük önderinden* gelecek haberleri bekliyordu."
  },
  {
   "t0": 20.32,
   "t1": 22.687,
   "text": "Yanında bulunanların aktardığına göre,"
  },
  {
   "t0": 22.905,
   "t1": 25.361,
   "text": "Atatürk'ün *bilinci* giderek bulanıklaşıyordu."
  },
  {
   "t0": 25.92,
   "t1": 27.091,
   "text": "Çok geçmeden,"
  },
  {
   "t0": 27.527,
   "t1": 29.349,
   "text": "derin bir *komaya* girecekti."
  },
  {
   "t0": 32.42,
   "t1": 33.764,
   "text": "*Tanıklıklara göre,*"
  },
  {
   "t0": 34.126,
   "t1": 36.188,
   "text": "dudaklarından dökülen *son söz,*"
  },
  {
   "t0": 39.488,
   "t1": 40.388,
   "text": "oldu."
  },
  {
   "t0": 44.22,
   "t1": 45.514,
   "text": "İki gün sonra,"
  },
  {
   "t0": 45.734,
   "t1": 47.866,
   "text": "*10 Kasım 1938'de,*"
  },
  {
   "t0": 48.062,
   "t1": 49.614,
   "text": "saat *dokuzu beş geçe,*"
  },
  {
   "t0": 50.11,
   "t1": 53.054,
   "text": "Mustafa Kemal Atatürk, *hayata gözlerini yumdu.*"
  },
  {
   "t0": 54.62,
   "t1": 55.677,
   "text": "Saygıyla,",
   "y": 1490
  },
  {
   "t0": 56.093,
   "t1": 56.993,
   "text": "özlemle,",
   "y": 1490
  },
  {
   "t0": 57.236,
   "t1": 58.768,
   "text": "ve *minnetle* anıyoruz.",
   "y": 1490
  }
 ],
