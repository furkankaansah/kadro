# Kadro ortam değişkenleri. Bu dosya otomatik okunmaz:
#  - Docker Compose ile: .env adıyla kopyala, doldur, `docker compose up -d --build`
#  - Elle: değişkenleri terminalde/servis tanımında ver (örn. PORT=8080 npm start)
# Hepsi geliştirme için isteğe bağlıdır; YAYINDA işaretli olanları doldur.

# --- Yayın için gerekli ---
# Docker Compose + Caddy kullanıyorsan alan adın:
DOMAIN=kadro.ornek.com
# Sitenin açık adresi (e-postadaki bağlantılar ve paylaşım görseli bununla oluşur):
PUBLIC_URL=https://kadro.ornek.com
# E-posta gönderimi. Aşağıdaki iki yoldan BİRİNİ doldur; ikisi de boşsa e-postalar kimseye gitmez ve kimse kayıt olup devam edemez.
# Yol 1 (kendi alan adın varsa, en iyisi): Resend
RESEND_API_KEY=
MAIL_FROM="Kadro <noreply@kadro.ornek.com>"
# Yol 2 (alan adı gerekmez, ücretsiz): Gmail ile. Ayrı bir Gmail hesabı aç, "2 adımlı doğrulama"yı aç,
#   Google Hesabı > Güvenlik > "Uygulama şifreleri"nden 16 haneli şifre üret ve buraya yaz (normal Gmail şifreni YAZMA).
#   Gmail günde yaklaşık 500 e-posta ile sınırlar; gönderen adres bu Gmail adresi olur (MAIL_FROM boş kalırsa otomatik "Kadro <adres>").
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=kadro.destek@gmail.com
# SMTP_PASS=abcdefghijklmnop
# SMTP_SECURE=tls        # 465 için tls, 587 için starttls
# Yönetici kullanıcı adların (virgülle). Şikâyetleri bu hesaplar inceler; e-postası doğrulanmış olmalı:
ADMIN_USERNAMES=
# Gizlilik/şartlar sayfalarında görünür:
OPERATOR_NAME=
CONTACT_EMAIL=
# Oturum çerezlerini imzalayan uzun rastgele metin (örn. `openssl rand -hex 32`):
KADRO_SECRET=

# --- HTTPS / ters vekil arkasında (Docker Compose bunları kendisi verir) ---
# COOKIE_SECURE=1
# TRUST_PROXY=1

# --- İsteğe bağlı ---
PORT=3000
HOST=0.0.0.0
# DATA_DIR=./data
# DB_FILE=./data/kadro.db
# SITE_NAME=Kadro
# Yedek: her BACKUP_EVERY_HOURS saatte bir DATA_DIR/backups içine, en son BACKUP_KEEP tane saklanır.
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=14
# BACKUP_EVERY_HOURS=24
# BACKUP=0   # yedeği kapatır
