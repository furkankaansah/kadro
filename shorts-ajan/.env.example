# --- ZORUNLU ---
# Claude API anahtarı: https://console.anthropic.com  -> API Keys
ANTHROPIC_API_KEY=

# --- ÖNERİLEN (ücretsiz) ---
# Telifsiz dikey stok videolar için: https://www.pexels.com/api/  (ücretsiz kayıt)
# Boş bırakırsan ajan renkli animasyonlu arka planlar kullanır.
PEXELS_API_KEY=

# --- OTOMATİK YÜKLEME (kurulum: kanal/YOUTUBE_BAGLANTI.md) ---
# evet = üretilen her video kanala kendiliğinden yüklenir
OTOMATIK_YUKLE=hayir
# public (herkese açık) / unlisted (liste dışı) / private (gizli)
YUKLEME_GIZLILIK=public
# Doluysa videolar hemen değil, bu saatlere sırayla zamanlanır (ör. 12:30,19:30). Boş = hemen yayınla.
YAYIN_SAATLERI=12:30,19:30

# --- İSTEĞE BAĞLI ---
# YouTube'da şu an trend olan videoları da görmek için (Google Cloud > YouTube Data API v3)
YOUTUBE_API_KEY=

# Kanal kimliği (videolara küçük imza + açıklamaya kanal satırı eklenir)
KANAL_ADI=Merakmetre
KANAL_KULLANICI=@merakmetre

# Kanal dili ve ülke: tr / TR  veya en / US
KANAL_DILI=tr
ULKE=TR

# Kanal konusu (boş = her konu). Örn: "teknoloji ve bilim", "ilginç bilgiler", "futbol"
KANAL_NISI=gündem, bilim, teknoloji, uzay ve ilginç bilgiler

# Seslendirme sesi (edge-tts). Türkçe: tr-TR-AhmetNeural (erkek) / tr-TR-EmelNeural (kadın)
SES=tr-TR-AhmetNeural
# Konuşma hızı: +0% normal, +10% biraz hızlı (shorts için iyi)
SES_HIZI=+12%

# Altyazı yazı tipi (bilgisayarında yüklü olmalı)
ALTYAZI_FONT=Arial Black
