{
  "name": "kadro",
  "version": "0.1.0",
  "description": "Kadro: oyun seç, açık grupları gör, grup kur; arkadaşlık, mesajlaşma ve kalıcı arkadaş grupları",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "test": "node --disable-warning=ExperimentalWarning test/smoke.js && node --disable-warning=ExperimentalWarning test/smtp.js",
    "check:live": "node scripts/check-live.mjs",
    "secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
  },
  "engines": {
    "node": ">=22.13"
  }
}
